# Optional. Every setting has a local default in src/config.ts, so the app runs without a .env. To change one, copy
# this file to .env (in this folder) and set it there; .env is gitignored. An empty value uses the default.
PORT=3000
# Signs the login cookie. Empty uses a local-only default; a server anyone else can reach must set long random text.
SESSION_SECRET=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gameatlas
DB_USER=gameatlas
# Empty uses the password backend/sql/init.sql gives the gameatlas MySQL user.
DB_PASSWORD=
