{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "C:/Program Files/nodejs/node.exe",
      "runtimeArgs": ["frontend/node_modules/vite/bin/vite.js", "frontend", "--port", "5173", "--strictPort"],
      "port": 5173
    },
    {
      "name": "backend",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--watch-path=backend/src",
        "--watch-path=frontend/src/schema",
        "--watch-path=frontend/src/data",
        "--watch-path=frontend/src/utils",
        "backend/src/server.ts"
      ],
      "port": 3000
    }
  ]
}
